PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3005
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
JWT_SECRET=replace-with-a-long-random-secret-in-production-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=
# Leave empty for embedded persistent PGlite (PostgreSQL 16 engine at ./data/pgdata),
# or provide a PostgreSQL/Supabase connection URI:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qayz
DATABASE_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
